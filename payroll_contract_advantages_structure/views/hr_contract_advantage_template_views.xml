<odoo>
    <record id="hr_contract_advantage_template_view_form" model="ir.ui.view">
        <field name="name">
            hr.contract.advantage.template.form.inherit.structure
        </field>
        <field name="model">hr.contract.advantage.template</field>
        <field
            name="inherit_id"
            ref="payroll_contract_advantages.hr_contract_advantage_template_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Salary Structures">
                    <field name="structure_ids" widget="many2many_tags" />
                </group>
            </xpath>
        </field>
    </record>
    <record id="hr_contract_advantage_template_view_tree" model="ir.ui.view">
        <field name="name">
            hr.contract.advantage.template.tree.inherit.structure
        </field>
        <field name="model">hr.contract.advantage.template</field>
        <field
            name="inherit_id"
            ref="payroll_contract_advantages.hr_contract_advantage_template_view_tree"
        />
        <field name="arch" type="xml">
            <field name="quantity_mode" position="after">
                <field name="structure_ids" widget="many2many_tags" />
            </field>
        </field>
    </record>
</odoo>
