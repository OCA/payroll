
<odoo>
    <template id="report_payslipdetails">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                       
                       
                        <h2 t-field="o.name" class="text-center pb-2"/>
                        <table class="table table-sm table-bordered">
                            <tr>
                                <td>
                                    <strong>Name</strong>
                                </td>
                                <td>
                                    <span t-field="o.employee_id" />
                                </td>
                                <td>
                                    <strong>Pan Number</strong>
                                </td>
                                <td>
                                    <span t-field="o.employee_id.job_id" />
                                </td>
                            </tr>
                            <tr>
                             <td>
                                    <strong>Designation</strong>
                                </td>
                                <td>
                                    <span t-field="o.employee_id.job_id" />
                                </td>
                                <td>
                                    <strong>Bank Ac</strong>
                                </td>
                                <td>
                                    <span t-field="o.employee_id.bank_account_id" />
                                </td>
                            </tr>
                            <tr>
                             <td>
                                    <strong>Employee ID</strong>
                                </td>
                                <td>
                                    <span t-field="o.employee_id" />
                                </td>
                                <td>
                                    <strong>IFSC Code</strong>
                                </td>
                                <td>
                                    <span t-field="o.employee_id.bank_account_id" />
                                </td>
                            </tr>
                             <tr>
                             <td>
                                    <strong>Date Of Join</strong>
                                </td>
                                <td>
                                    <span t-field="o.employee_id.job_id" />
                                </td>
                                <td>
                                    <strong>Paid Days</strong>
                                </td>
                                <td>
                                    <span t-field="o.employee_id.job_id" />
                                </td>
                            </tr>
                            <tr>
                                <td>
                                     <strong>LOP Days</strong>
                                </td>
                                <td>
                                    <span t-field="o.employee_id.job_id" />
                                </td>
                            </tr>
                           
                        </table>
                        <h3>Payslip Lines by Contribution Register</h3>
                        <table class="table table-sm mb32">
                            <thead>
                                <tr style="background-color:orange; color:#ffa803;">
                                    <th>Earning</th>
                                    <th>Rs</th>
                                    <th>Deducation</th>
                                     <th>Rs</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="earnings" t-value="[]"/>
                                <t t-set="deductions" t-value="[]"/>

                                <!-- Categorize lines into earnings and deductions -->
                                <t t-foreach="o.line_ids" t-as="line">
                                    <t t-if="line.total >= 0">
                                        <t t-set="earnings" t-value="earnings + [line]"/>
                                    </t>
                                    <t t-if="line.total &lt; 0">
                                        <t t-set="deductions" t-value="deductions + [line]"/>
                                    </t>
                                </t>

                                <!-- Calculate the maximum number of rows to show -->
                                <t t-set="max_len" t-value="max(len(earnings), len(deductions))"/>

                                <!-- Loop to print rows -->
                                <t t-foreach="range(max_len)" t-as="i">
                                    <tr>
                                        <!-- Earnings Column -->
                                        <td>
                                            <t t-if="i &lt; len(earnings)">
                                                <span t-esc="earnings[i].name"/>
                                            </t>
                                        </td>
                                        <td>
                                            <t t-if="i &lt; len(earnings)">
                                                <span t-esc="earnings[i].total"/>
                                            </t>
                                        </td>

                                        <!-- Deductions Column -->
                                        <td>
                                            <t t-if="i &lt; len(deductions)">
                                                <span t-esc="deductions[i].name"/>
                                            </t>
                                        </td>
                                        <td>
                                            <t t-if="i &lt; len(deductions)">
                                                <span t-esc="abs(deductions[i].total)"/>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th>Total Earnings</th>
                                    <td>
                                        <span t-esc="sum(l.total for l in earnings)"/>
                                    </td>
                                    <th>Total Deduction</th>
                                    <td>
                                        <span t-esc="abs(sum(l.total for l in deductions))"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3" style="font-weight:bold; text-align:left;">
                                        Net Salary
                                    </td>
                                    <td style="font-weight:bold; margin-left:40px;">
                                        <span t-esc="sum(l.total for l in earnings) - abs(sum(l.total for l in deductions))"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                        
                        <p class="text-right">
                            <strong>Authorized signature</strong>
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
