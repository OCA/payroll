<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="module_category_payroll" model="ir.module.category">
        <field name="name">Payroll</field>
        <field name="description">Manage employee payroll</field>
        <field name="sequence" eval="16" />
    </record>
    <record id="res_groups_privilege_payroll" model="res.groups.privilege">
        <field name="name">Payroll</field>
        <field name="sequence" eval="16" />
        <field name="category_id" ref="module_category_payroll" />
    </record>
    <record id="group_payroll_user" model="res.groups">
        <field name="name">Officer</field>
        <field name="privilege_id" ref="res_groups_privilege_payroll" />
        <field
            name="implied_ids"
            eval="[(4, ref('hr.group_hr_user')), (4, ref('hr.group_hr_manager'))]"
        />
    </record>
    <record id="group_payroll_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_payroll" />
        <field name="implied_ids" eval="[(4, ref('payroll.group_payroll_user'))]" />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
</odoo>
