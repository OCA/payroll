#. module: payroll_rule_tag
#. odoo-python
#: code:addons/payroll_rule_tag/models/hr_salary_rule_tag.py:0
msgid ""
"Tag '%(name)s' resolves to the code '%(code)s', which is already used by the"
" tag '%(other)s'. Salary rules could not tell the two totals apart, so "
"please set a distinct code or name."
msgstr "La etiqueta '%(name)s' se resuelve al código '%(code)s', que ya utiliza la etiqueta '%(other)s'. Las reglas salariales no podrían distinguir ambos totales, así que indique un código o un nombre distinto."

#. module: payroll_rule_tag
#: model_terms:ir.ui.view,arch_db:payroll_rule_tag.view_hr_salary_rule_tag_form
msgid "Tag Name"
msgstr "Nombre de la etiqueta"

#. module: payroll_rule_tag
#. odoo-python
#: code:addons/payroll_rule_tag/models/hr_salary_rule_tag.py:0
msgid ""
"Tag code '%(code)s' must be a valid Python identifier. Please use only "
"letters, numbers, and underscores, and don't start with a number."
msgstr "El código de etiqueta '%(code)s' debe ser un identificador válido de Python. Utilice únicamente letras, números y guiones bajos, y no empiece por un número."

#. module: payroll_rule_tag
#: model:ir.model.constraint,message:payroll_rule_tag.constraint_hr_salary_rule_tag_code_company_unique
msgid "Tag code must be unique per company!"
msgstr "¡El código de la etiqueta debe ser único por compañía!"

#. module: payroll_rule_tag
#. odoo-python
#: code:addons/payroll_rule_tag/models/hr_salary_rule_tag.py:0
msgid ""
"Tag name '%(name)s' cannot be converted to a valid Python identifier. Please"
" use only letters, numbers, and underscores, and don't start with a number."
msgstr "El nombre de etiqueta '%(name)s' no se puede convertir en un identificador válido de Python. Utilice únicamente letras, números y guiones bajos, y no empiece por un número."

#. module: payroll_rule_tag
#: model:ir.model.constraint,message:payroll_rule_tag.constraint_hr_salary_rule_tag_name_company_unique
msgid "Tag name must be unique per company!"
msgstr "¡El nombre de la etiqueta debe ser único por compañía!"

