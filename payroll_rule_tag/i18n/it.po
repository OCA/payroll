#. module: payroll_rule_tag
#. odoo-python
#: code:addons/payroll_rule_tag/models/hr_salary_rule_tag.py:0
msgid ""
"Tag code '%(code)s' must be a valid Python identifier. Please use only "
"letters, numbers, and underscores, and don't start with a number."
msgstr ""
"Il codice dell'etichetta '%(code)s' deve essere un identificativo Python "
"valido. Utilizza solo lettere, numeri e trattini bassi e non iniziare con un "
"numero."

