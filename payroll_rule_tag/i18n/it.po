#: model_terms:ir.ui.view,arch_db:payroll_rule_tag.hr_salary_rule_view_form
msgid "Tags to categorize this salary rule for reporting and calculations"
msgstr ""
"Etichette per classificare questa regola salariale ai fini dei resoconti e "
"dei calcoli"

