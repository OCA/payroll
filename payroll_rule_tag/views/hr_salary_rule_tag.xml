<odoo>
    <record id="view_hr_salary_rule_tag_list" model="ir.ui.view">
        <field name="model">hr.salary.rule.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="view_hr_salary_rule_tag_form" model="ir.ui.view">
        <field name="model">hr.salary.rule.tag</field>
        <field name="arch" type="xml">
            <form>
                <field name="name" />
            </form>
        </field>
    </record>

    <record id="action_hr_salary_rule_tag" model="ir.actions.act_window">
        <field name="name">Salary Rule Tags</field>
        <field name="res_model">hr.salary.rule.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_hr_salary_rule_tag"
        name="Salary Rule Tags"
        parent="payroll.payroll_menu_configuration"
        sequence="13"
    />
</odoo>
