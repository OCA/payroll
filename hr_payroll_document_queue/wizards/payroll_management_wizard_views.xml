<odoo>
    <record id="payrolls_management_wizard_form" model="ir.ui.view">
        <field
            name="name"
        >Add Async buttons and fields Payroll Management form view</field>
        <field name="model">payroll.management.wizard</field>
        <field
            name="inherit_id"
            ref="hr_payroll_document.payrolls_management_wizard_form"
        />
        <field name="arch" type="xml">
            <field name="payrolls" position="after">
                <field name="is_payroll_being_processed" invisible="True" />
                <div
                    class="alert alert-warning text-center"
                    role="alert"
                    invisible="not is_payroll_being_processed"
                >
                    <i class="fa fa-warning" title="Warning" />
                    <div>
                        One of the selected payrolls is already being processed
                    </div>
                </div>
            </field>
            <button name="send_payrolls" position="before">
                <field name="is_send_visible" invisible="True" />
            </button>
            <button name="send_payrolls" position="attributes">
                <attribute name="invisible">not is_send_visible</attribute>
            </button>
            <button name="send_payrolls" position="after">
                <button
                    string="Send Async"
                    name="send_payrolls_async"
                    type="object"
                    class="oe_highlight"
                    invisible="not is_send_visible"
                />
            </button>
        </field>
    </record>
</odoo>
