<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_payslip_view_tree_inherit_due_date" model="ir.ui.view">
        <field name="name">hr.payslip.tree.inherit.due.date</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.hr_payslip_view_tree" />
        <field name="priority" eval="20" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_to']" position="after">
                <field name="payment_due_is_overdue" invisible="1" />
                <field name="payment_due_is_ok" invisible="1" />
                <field
                    name="payment_due_date"
                    optional="show"
                    decoration-danger="payment_due_is_overdue"
                    decoration-success="payment_due_is_ok"
                />
            </xpath>
        </field>
    </record>

    <record id="hr_payslip_view_form_inherit_due_date" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.due.date</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.hr_payslip_view_form" />
        <field name="priority" eval="20" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='contract_id']" position="before">
                <field name="payment_due_date" />
            </xpath>
        </field>
    </record>
</odoo>
